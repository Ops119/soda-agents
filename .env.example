# Public site URL. Used for sign-in, emails, and download links.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123

# Solana is hard-locked to devnet. A mainnet cluster, RPC, or USDC mint is refused.
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Circle devnet USDC. Do not put the mainnet mint here.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Treasury that receives USDC. Leave unset in local dev and the app writes
# .data/devnet-treasury.json (gitignored). Set a real address before sharing a deploy.
# TREASURY_PUBKEY=
# NEXT_PUBLIC_TREASURY_PUBKEY=

# HMAC secret for sessions and download links. Required in production, 32+ characters.
# SESSION_SECRET=

# Supabase. Both must be set or the app uses .data/store.json.
# The service role key is server-only. Never prefix it with NEXT_PUBLIC_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Set ALLOW_LOCAL_STORE=true only if you intentionally run production without Supabase.
# ALLOW_LOCAL_STORE=

# Optional. The app keeps working when these are unset.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RESEND_API_KEY=
# RESEND_FROM="Soda.agents <receipts@example.com>"
# SENTRY_DSN=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CRON_SECRET=
# NEXT_PUBLIC_PHANTOM_APP_ID=

# UK execution block is off unless set to true. EU-27 is always blocked for execution agents.
# GEO_BLOCK_UK=false
# NEXT_PUBLIC_GEO_BLOCK_UK=false

# NEXT_PUBLIC_LEGAL_ENTITY=Soda.agents
# NEXT_PUBLIC_CONTACT_EMAIL=hello@soda.agents

# Comma-separated HTTPS hostnames the gateway may call. stub:echo always works.
# AGENT_ENDPOINT_ALLOWLIST=
